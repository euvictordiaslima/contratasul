rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    // Exclusões administrativas exigem login recente (até 5 min).
    function recentAdmin() {
      return isAdmin() && request.auth.token.auth_time is int
        && request.auth.token.auth_time * 1000 > request.time.toMillis() - 300000;
    }
    function validMedia() {
      return request.resource.data.keys().hasOnly([
        'type','title','description','imageUrl','linkUrl','order','active','createdAt','updatedAt'
      ])
      && request.resource.data.keys().hasAll([
        'type','title','description','imageUrl','linkUrl','order','active','createdAt','updatedAt'
      ])
      && request.resource.data.type in ['banner','material']
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
      && request.resource.data.description is string && request.resource.data.description.size() <= 240
      && request.resource.data.imageUrl is string
      && request.resource.data.imageUrl.size() <= 1200
      && request.resource.data.imageUrl.matches('^https://.+')
      && request.resource.data.linkUrl is string
      && request.resource.data.linkUrl.size() <= 1200
      && (request.resource.data.linkUrl == '' || request.resource.data.linkUrl.matches('^https://.+'))
      && request.resource.data.order is int
      && request.resource.data.order >= 0 && request.resource.data.order <= 999
      && request.resource.data.active is bool
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp;
    }
    match /midia_site/{mediaId} {
      // Visitantes só podem listar documentos ativos: query where('active','==',true).
      allow get, list: if isAdmin() || resource.data.active == true;
      allow create: if isAdmin() && validMedia()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() && validMedia()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if recentAdmin();
    }
    function validVaga() {
      return request.resource.data.keys().hasOnly([
        'title','company','location','mode','contract','salary',
        'description','cnpj','published','createdAt','updatedAt'
      ])
      && request.resource.data.keys().hasAll([
        'title','company','location','mode','contract','salary',
        'description','published','createdAt','updatedAt'
      ])
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 100
      && request.resource.data.company is string
      && request.resource.data.company.size() <= 100
      && request.resource.data.location is string
      && request.resource.data.location.size() <= 100
      && request.resource.data.mode in ['Presencial','Híbrido','Remoto']
      && request.resource.data.contract is string
      && request.resource.data.contract.size() <= 100
      && request.resource.data.salary is string
      && request.resource.data.salary.size() <= 100
      && request.resource.data.description is string
      && request.resource.data.description.size() <= 2500
      && (!request.resource.data.keys().hasAny(['cnpj']) || (request.resource.data.cnpj is string && (request.resource.data.cnpj == '' || request.resource.data.cnpj.matches('^[0-9]{14}$'))))
      && request.resource.data.published is bool
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp;
    }
    match /lixeira/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.auth.token.auth_time is int
        && request.auth.token.auth_time * 1000 > request.time.toMillis() - 300000
        && request.resource.data.originalId == id
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.deletedAt == request.time
        && request.resource.data.keys().hasAll(['title','company','location','mode','contract','salary','description','published','createdAt','updatedAt','originalId','deletedAt','deletedBy']);
      allow delete: if isAdmin() && request.auth.token.auth_time is int
        && request.auth.token.auth_time * 1000 > request.time.toMillis() - 300000;
      allow update: if false;
    }
    match /loginAliases/{username} {
      allow get: if false;
      allow list, create, update, delete: if false;
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /vagas/{vagaId} {
      allow get: if isAdmin() || resource.data.published == true;
      allow list: if isAdmin() || resource.data.published == true;
      allow create: if isAdmin() && validVaga();
      allow update: if isAdmin() && validVaga()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin()
        && request.auth.token.auth_time is int
        && request.auth.token.auth_time * 1000 > request.time.toMillis() - 300000;
    }
    function shortText(field, maxLen) {
      return field is string && field.size() <= maxLen;
    }
    function validCandidaturaAdmin() {
      return request.resource.data.keys().hasOnly([
        'jobId','jobTitle','name','email','phone','contactPreference','message','consent','stage',
        'resumePath','resumeStore','resumeName','resumeType','resumeSize','uploaderUid','createdAt','updatedAt'
      ])
        && shortText(request.resource.data.jobId,128)
        && shortText(request.resource.data.jobTitle,100)
        && shortText(request.resource.data.name,100)
        && shortText(request.resource.data.email,150)
        && shortText(request.resource.data.phone,25)
        && request.resource.data.get('contactPreference','WhatsApp') in ['WhatsApp','Ligação','E-mail']
        && shortText(request.resource.data.message,1500)
        && request.resource.data.consent == true
        && request.resource.data.stage in ['Recebido','Em análise','Entrevista','Aprovado','Encerrado']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAny(['resumeStore']) || request.resource.data.resumeStore == 'firestore-v1')
        && (!request.resource.data.keys().hasAny(['resumePath']) || (
          shortText(request.resource.data.resumePath,300)
          && shortText(request.resource.data.resumeName,120)
          && request.resource.data.resumeType in ['application/pdf','application/vnd.openxmlformats-officedocument.wordprocessingml.document']
          && request.resource.data.resumeSize is int
          && request.resource.data.resumeSize >= 100
          && request.resource.data.resumeSize <= 5242880
          && shortText(request.resource.data.uploaderUid,128)
        ));
    }
    // Documentos privados: somente o administrador pode ler currículos.
    // Um visitante pode apenas CRIAR o arquivo junto à candidatura em lote atômico; nunca ler.
    match /curriculos/{id} {
      allow get, list: if isAdmin();
      allow create: if request.auth == null
        && request.resource.data.keys().hasOnly([
          'candidateId','ownerUid','fileName','fileType','fileSize','contentBase64','createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'candidateId','ownerUid','fileName','fileType','fileSize','contentBase64','createdAt'
        ])
        && request.resource.data.candidateId == id
        && request.resource.data.ownerUid == 'public'
        && shortText(request.resource.data.fileName,120)
        && request.resource.data.fileName.size() > 0
        && request.resource.data.fileType in ['application/pdf','application/vnd.openxmlformats-officedocument.wordprocessingml.document']
        && request.resource.data.fileSize is int
        && request.resource.data.fileSize >= 100
        && request.resource.data.fileSize <= 716800
        && request.resource.data.contentBase64 is string
        && request.resource.data.contentBase64.size() >= 136
        && request.resource.data.contentBase64.size() <= 960000
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/candidaturas/$(id)).data.uploaderUid == 'public'
        && getAfter(/databases/$(database)/documents/candidaturas/$(id)).data.resumeStore == 'firestore-v1'
        && getAfter(/databases/$(database)/documents/candidaturas/$(id)).data.resumeName == request.resource.data.fileName
        && getAfter(/databases/$(database)/documents/candidaturas/$(id)).data.resumeSize == request.resource.data.fileSize
        && getAfter(/databases/$(database)/documents/candidaturas/$(id)).data.resumeType == request.resource.data.fileType;
      allow update: if false;
      allow delete: if recentAdmin();
    }
    match /candidaturas/{id} {
      allow create: if (isAdmin() && validCandidaturaAdmin()) || (request.auth == null
        && request.resource.data.keys().hasOnly([
          'jobId','jobTitle','name','email','phone','contactPreference','message','consent','stage',
          'resumeStore','resumeName','resumeType','resumeSize','uploaderUid','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'jobId','jobTitle','name','email','phone','contactPreference','message','consent','stage',
          'resumeStore','resumeName','resumeType','resumeSize','uploaderUid','createdAt','updatedAt'
        ])
        && shortText(request.resource.data.jobId,128)
        && request.resource.data.jobId.matches('^[a-zA-Z0-9_-]+$')
        && exists(/databases/$(database)/documents/vagas/$(request.resource.data.jobId))
        && get(/databases/$(database)/documents/vagas/$(request.resource.data.jobId)).data.published == true
        && request.resource.data.jobTitle == get(/databases/$(database)/documents/vagas/$(request.resource.data.jobId)).data.title
        && shortText(request.resource.data.name,100) && request.resource.data.name.size() > 1
        && shortText(request.resource.data.email,150)
        && (request.resource.data.email == '' || request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$'))
        && request.resource.data.contactPreference in ['WhatsApp','Ligação','E-mail']
        && (request.resource.data.contactPreference != 'E-mail' || request.resource.data.email != '')
        && shortText(request.resource.data.phone,25)
        && request.resource.data.phone.matches('^[0-9]{10,13}$')
        && shortText(request.resource.data.message,1500)
        && request.resource.data.consent == true
        && request.resource.data.stage == 'Recebido'
        && request.resource.data.uploaderUid == 'public'
        && request.resource.data.resumeStore == 'firestore-v1'
        && shortText(request.resource.data.resumeName,120)
        && request.resource.data.resumeName.size() > 0
        && request.resource.data.resumeSize is int
        && request.resource.data.resumeSize >= 100
        && request.resource.data.resumeSize <= 716800
        && request.resource.data.resumeType in ['application/pdf','application/vnd.openxmlformats-officedocument.wordprocessingml.document']
        && getAfter(/databases/$(database)/documents/curriculos/$(id)).data.ownerUid == 'public'
        && getAfter(/databases/$(database)/documents/curriculos/$(id)).data.fileSize == request.resource.data.resumeSize
        && getAfter(/databases/$(database)/documents/curriculos/$(id)).data.fileType == request.resource.data.resumeType
        && getAfter(/databases/$(database)/documents/curriculos/$(id)).data.fileName == request.resource.data.resumeName
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time);
      allow get, list: if isAdmin();
      allow update: if (isAdmin() && validCandidaturaAdmin()) || (isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stage','updatedAt'])
        && request.resource.data.stage in ['Recebido','Em análise','Entrevista','Aprovado','Encerrado']
        && request.resource.data.updatedAt == request.time);
      allow delete: if recentAdmin();
    }
    // Campos extras opcionais para cadastro empresarial. Somente administradores leem estes dados.
    function optionalText(data, field, maxLen) {
      return data.get(field, '') is string && data.get(field, '').size() <= maxLen;
    }
    function validEmpresa() {
      return request.resource.data.keys().hasOnly([
          'name','cnpj','email','phone','city','createdAt','updatedAt',
          'tradeName','status','openingDate','cnae','legalNature','size',
          'website','address','district','zip','state','notes'
        ])
        && request.resource.data.keys().hasAll(['name','cnpj','email','phone','city','createdAt','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && optionalText(request.resource.data, 'cnpj', 14)
        && (request.resource.data.cnpj == '' || request.resource.data.cnpj.matches('^[0-9]{14}$'))
        && optionalText(request.resource.data, 'email', 150)
        && optionalText(request.resource.data, 'phone', 30)
        && optionalText(request.resource.data, 'city', 100)
        && optionalText(request.resource.data, 'tradeName', 120)
        && optionalText(request.resource.data, 'status', 80)
        && optionalText(request.resource.data, 'openingDate', 10)
        && (request.resource.data.get('openingDate','') == '' || request.resource.data.openingDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && optionalText(request.resource.data, 'cnae', 180)
        && optionalText(request.resource.data, 'legalNature', 130)
        && optionalText(request.resource.data, 'size', 60)
        && optionalText(request.resource.data, 'website', 200)
        && (request.resource.data.get('website','') == '' || request.resource.data.website.matches('^https?://.+$'))
        && optionalText(request.resource.data, 'address', 180)
        && optionalText(request.resource.data, 'district', 90)
        && optionalText(request.resource.data, 'zip', 8)
        && (request.resource.data.get('zip','') == '' || request.resource.data.zip.matches('^[0-9]{8}$'))
        && optionalText(request.resource.data, 'state', 2)
        && (request.resource.data.get('state','') == '' || request.resource.data.state.matches('^[A-Z]{2}$'))
        && optionalText(request.resource.data, 'notes', 1200)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }
    match /empresas/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validEmpresa();
      allow update: if isAdmin() && validEmpresa()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin()
        && request.auth.token.auth_time is int
        && request.auth.token.auth_time * 1000 > request.time.toMillis() - 300000;
    }
    function validEntrevista() {
      return request.resource.data.keys().hasOnly([
          'candidateId','candidateName','when','location','notes','status','createdAt',
          'duration','modality','interviewer'
        ])
        && request.resource.data.keys().hasAll(['candidateId','candidateName','when','location','notes','status','createdAt'])
        && shortText(request.resource.data.candidateId,128)
        && shortText(request.resource.data.candidateName,100)
        && shortText(request.resource.data.when,40)
        && shortText(request.resource.data.location,300)
        && shortText(request.resource.data.notes,1000)
        && optionalText(request.resource.data,'duration',3)
        && request.resource.data.get('duration','') in ['', '15','30','45','60','90','120']
        && optionalText(request.resource.data,'modality',20)
        && request.resource.data.get('modality','') in ['', 'Presencial','Online','Telefone']
        && optionalText(request.resource.data,'interviewer',100)
        && request.resource.data.status in ['Agendada','Concluída','Cancelada']
        && request.resource.data.createdAt is timestamp;
    }
    match /entrevistas/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validEntrevista();
      allow update: if isAdmin() && validEntrevista()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin()
        && request.auth.token.auth_time is int
        && request.auth.token.auth_time * 1000 > request.time.toMillis() - 300000;
    }
    match /configuracoes/{id} {
      allow get: if id == 'site';
      allow list: if isAdmin();
      allow create, update: if isAdmin() && id == 'site'
        && request.resource.data.keys().hasOnly(['title','description','whatsapp','updatedAt'])
        && shortText(request.resource.data.title,120)
        && shortText(request.resource.data.description,600)
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.matches('^[0-9]{10,15}$')
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }
    match /historico/{id} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['action','detail','actor','at'])
        && shortText(request.resource.data.action,100)
        && shortText(request.resource.data.detail,180)
        && request.resource.data.actor == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
    // Acesso individual ao portal empresarial. Somente o administrador pode vincular um UID.
    function portalMember(companyId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/portal_empresas/$(request.auth.uid))
        && get(/databases/$(database)/documents/portal_empresas/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/portal_empresas/$(request.auth.uid)).data.companyId == companyId;
    }
    match /portal_empresas/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['companyId','companyName','tradeName','active','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['companyId','companyName','tradeName','active','createdAt','updatedAt'])
        && request.resource.data.companyId is string
        && request.resource.data.companyId.matches('^[A-Za-z0-9_-]{1,128}$')
        && exists(/databases/$(database)/documents/empresas/$(request.resource.data.companyId))
        && request.resource.data.companyName is string
        && request.resource.data.companyName.size() <= 120
        && request.resource.data.tradeName is string
        && request.resource.data.tradeName.size() <= 120
        && request.resource.data.active is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['companyId','companyName','tradeName','active','createdAt','updatedAt'])
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.companyName is string
        && request.resource.data.companyName.size() <= 120
        && request.resource.data.tradeName is string
        && request.resource.data.tradeName.size() <= 120
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if recentAdmin();
    }
    // CRM: todos os dados empresariais e pessoais são privados ao administrador.

    function crmText(data, field, maxLen) {
      return data.get(field, '') is string && data.get(field, '').size() <= maxLen;
    }
    function crmValid(kind) {
      return request.resource.data.keys().hasOnly(['companyId','candidateId','candidateName','role','status','hiredAt','note','name','email','phone','qty','due','priority','title','owner','done','type','text','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['companyId','createdAt','updatedAt'])
        && crmText(request.resource.data,'companyId',128)
        && request.resource.data.companyId.matches('^[a-zA-Z0-9_-]+$')
        && exists(/databases/$(database)/documents/empresas/$(request.resource.data.companyId))
        && crmText(request.resource.data,'candidateId',128)
        && crmText(request.resource.data,'candidateName',100)
        && crmText(request.resource.data,'role',100)
        && crmText(request.resource.data,'status',30)
        && crmText(request.resource.data,'hiredAt',10)
        && crmText(request.resource.data,'note',400)
        && crmText(request.resource.data,'name',100)
        && crmText(request.resource.data,'email',150)
        && crmText(request.resource.data,'phone',30)
        && crmText(request.resource.data,'due',10)
        && crmText(request.resource.data,'priority',15)
        && crmText(request.resource.data,'title',150)
        && crmText(request.resource.data,'owner',100)
        && crmText(request.resource.data,'type',30)
        && crmText(request.resource.data,'text',1200)
        && request.resource.data.get('qty',1) is int
        && request.resource.data.get('qty',1) >= 1
        && request.resource.data.get('qty',1) <= 999
        && request.resource.data.get('done',false) is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }
    match /crm_relacionamentos/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && exists(/databases/$(database)/documents/empresas/$(id))
        && request.resource.data.keys().hasOnly(['status','owner','updatedAt'])
        && request.resource.data.keys().hasAll(['status','owner','updatedAt'])
        && request.resource.data.status in ['Prospecto','Em negociação','Cliente ativo','Cliente inativo']
        && request.resource.data.owner is string
        && request.resource.data.owner.size() <= 100
        && request.resource.data.updatedAt == request.time;
      allow delete: if recentAdmin();
    }
    match /crm_vinculos/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && crmValid('vinculos') && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && crmValid('vinculos') && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.companyId == resource.data.companyId;
      allow delete: if recentAdmin();
    }
    match /crm_solicitacoes/{id} {
      // No portal, a consulta deve filtrar companyId == empresa autorizada.
      allow read: if isAdmin() || portalMember(resource.data.companyId);
      allow create: if isAdmin() && crmValid('solicitacoes') && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && crmValid('solicitacoes') && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.companyId == resource.data.companyId;
      allow delete: if recentAdmin();
    }
    match /crm_contatos/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && crmValid('contatos') && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && crmValid('contatos') && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.companyId == resource.data.companyId;
      allow delete: if recentAdmin();
    }
    match /crm_tarefas/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && crmValid('tarefas') && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && crmValid('tarefas') && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.companyId == resource.data.companyId;
      allow delete: if recentAdmin();
    }
    match /crm_atividades/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && crmValid('atividades') && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if recentAdmin();
    }
    // Metadados e atividades novos do CRM. Arquivos não são armazenados aqui.
    function crmExtra() {
      return request.resource.data.keys().hasOnly([
        'companyId','title','status','amount','due','details',
        'category','reference','author','rating','text','createdAt','updatedAt'
      ])
      && request.resource.data.keys().hasAll(['companyId','createdAt','updatedAt'])
      && request.resource.data.companyId is string
      && request.resource.data.companyId.matches('^[A-Za-z0-9_-]{1,128}$')
      && exists(/databases/$(database)/documents/empresas/$(request.resource.data.companyId))
      && crmText(request.resource.data,'title',150)
      && crmText(request.resource.data,'status',35)
      && crmText(request.resource.data,'due',10)
      && crmText(request.resource.data,'details',1200)
      && crmText(request.resource.data,'category',40)
      && crmText(request.resource.data,'reference',300)
      && crmText(request.resource.data,'author',100)
      && crmText(request.resource.data,'text',1200)
      && request.resource.data.get('amount',0) is number
      && request.resource.data.get('amount',0) >= 0
      && request.resource.data.get('amount',0) <= 999999999
      && request.resource.data.get('rating',5) is int
      && request.resource.data.get('rating',5) >= 1
      && request.resource.data.get('rating',5) <= 5
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp;
    }
    match /crm_propostas/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && crmExtra()
        && request.resource.data.status in ['Rascunho','Enviada','Em negociação','Aprovada','Recusada']
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && crmExtra()
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['Rascunho','Enviada','Em negociação','Aprovada','Recusada'];
      allow delete: if recentAdmin();
    }
    match /crm_financeiro/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && crmExtra()
        && request.resource.data.status in ['Pendente','Pago','Cancelado']
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && crmExtra()
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['Pendente','Pago','Cancelado'];
      allow delete: if recentAdmin();
    }
    match /crm_documentos/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && crmExtra()
        && request.resource.data.category in ['Contrato','Proposta','Comprovante','Relatório','Outro']
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && crmExtra()
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if recentAdmin();
    }
    match /crm_avaliacoes/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && crmExtra()
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && crmExtra()
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if recentAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
